{
  "name": "detox",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "openapi": "tsx scripts/openapi.mts",
    "prebuild": "pnpm openapi",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky",
    "postinstall": "prisma generate",
    "db:seed": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed.mts",
    "db:indexes": "prisma db push --skip-generate && tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/indexes.mts",
    "db:smoke": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/smoke.mts",
    "db:ping": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/ping.mts"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "files-sdk": "^3.1.2",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "next-swagger-doc": "^0.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "swr": "^2.5.1",
    "uploadthing": "^7.7.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.2",
    "husky": "^9.1.7",
    "prisma": "6.19.3",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.26.0"
}
