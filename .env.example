# Copier en .env (lu par `next dev`, Prisma, `pnpm db:seed` et `pnpm db:indexes`).
# `.env.local`, s'il existe, l'emporte : pratique pour viser le Mongo Docker sans toucher à `.env`.
# Chaîne de connexion MongoDB Atlas (Database > Connect > Drivers), base incluse dans le chemin.
# En local avec `docker compose up -d --wait` : mongodb://localhost:27017/detox?directConnection=true
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/detox?retryWrites=true&w=majority
# From https://uploadthing.com/dashboard → API Keys
UPLOADTHING_TOKEN=
# Stable HMAC secret for the files-sdk upload round-trip (openssl rand -hex 32)
FILES_API_SECRET=
