# AUTH
## JWT secret
JWT_SECRET=change-me
## sessions NextAuth "openssl rand -base64 32"
AUTH_SECRET=change-me
AUTH_TRUST_HOST=true

# DATABASE
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dev?retryWrites=true&w=majority
# Mots de passe de admin@detox.app et user@detox.app créés par db:seed (aléatoires si absents)
# SEED_ADMIN_PASSWORD=
# SEED_USER_PASSWORD=
